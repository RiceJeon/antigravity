["AI 유입을 어떻게 식별하고 측정하나요?","원태그로 연동된 데이터매니저가 모든 유입 경로를 수집합니다. ChatGPT·Gemini·Perplexity 등 AI 도메인 유입은 UTM 파라미터 및 레퍼러 URL 분석으로 별도 식별되어, 일·주·월 단위로 대시보드에서 확인할 수 있습니다."],
["레퍼러 트래킹이 직전 URL 기준인가요?","직전 레퍼러(Referrer) 방식입니다. AI 서비스에서 링크를 클릭해 사이트로 바로 넘어온 경우에만 AI 유입으로 집계하므로, 직접 기여 데이터로서의 신뢰도가 높습니다."],
["배포된 콘텐츠로 발생한 유입과 매출을 트래킹할 수 있나요?","가능합니다. AI 서비스를 통해 직접 유입된 트래픽을 실시간 트래킹하고, 구매·문의 등 전환 데이터도 함께 집계합니다. 콘텐츠 배포 전후 유입량·전환 수 비교로 직접적인 성과 검증이 가능합니다."],
["AI 인용률 자체를 수치로 측정할 수 있나요?","인용률을 직접 수치화하기보다 AI 유입 증가량과 전환 수를 핵심 성과 지표로 트래킹합니다. AI 노출은 확률적 특성이 있어, 실제 비즈니스 성과로 연결되는 유입·전환 데이터 기준이 더 신뢰도 높은 방식입니다."],
["GEO 점수는 어떤 기준으로 산정되나요?","6개 영역(메타데이터·본문 구조·구조화 데이터·기술 접근성·GEO 신호·E-E-A-T)을 가중치 적용해 100점 만점으로 산출합니다. 자세한 내용은 'GEO 점수 보는 법' 문서를 참고하세요."],
]},

"faq-content":{cat:"자주 묻는 질문", title:"FAQ · 콘텐츠 생성", lead:"콘텐츠 생성 방식과 저작권에 대한 질문입니다.", faq:[
["비커머스 고객사나 SKU가 적은 고객사도 효과가 있나요?","네. 브랜드·업종 특성을 분석한 맞춤형 콘텐츠 생성 방식을 별도로 제공합니다. 전용 프롬프트·파인튜닝으로 콘텐츠 수가 적어도 AI 인용 가능성이 높은 고품질 콘텐츠를 확보할 수 있으며, 진단·구조 최적화·트래킹만으로도 충분한 가치를 얻을 수 있습니다."],
["콘텐츠 생성 방식과 브랜드 톤 조절이 가능한가요?","사이트 내 정보를 기반으로 자동 생성하는 것이 기본입니다. 커머스는 상품 항목별 생성 범위 선택이, 비커머스는 개별 문구 직접 수정이 가능합니다. 프롬프트 설정·파인튜닝으로 브랜드 아이덴티티를 반영할 수 있어 일정 수준의 브랜드 컨트롤이 가능합니다."],
["자동 생성 콘텐츠의 저작권은 누구에게 있나요?","광고주에게 귀속됩니다. 광고주의 상품·브랜드 데이터를 기반으로 생성되고, 광고주가 최종 컨펌 후 배포하는 구조이므로 소유권은 광고주에게 있습니다."],
["영어 콘텐츠도 AI에서 인용이 되나요?","AI 엔진은 사용자 IP 위치 기반으로 인용 콘텐츠를 결정하는 경향이 있습니다. 한국 IP 검색 시 한국 사이트가 인용될 가능성이 높아, 현재는 국내 최적화에 집중하는 것이 효율적입니다. 글로벌 대응은 다국어 최적화 고도화를 통해 단계적으로 확장 예정입니다."],
]},

"faq-ops":{cat:"자주 묻는 질문", title:"FAQ · 운영 & 리스크", lead:"업데이트 주기, 알고리즘 변화 대응 등 운영 관련 질문입니다.", faq:[
["업데이트 주기, 대시보드, 자동화 수준은 어떻게 되나요?","진단 항목 고도화는 월 1회 이상 정기 업데이트됩니다. 유입 트래킹·성과 대시보드와 동종 업종 비교 데이터를 제공하며, 초기 설정 후 대부분의 운영은 원클릭으로 자동화됩니다."],
["AI 알고리즘이 바뀌면 노출이 갑자기 사라지는 리스크는 없나요?","AI 엔진의 알고리즘·인용 기준 변동에 대응하기 위해 월 1회 이상 정기 점검 및 진단 항목 업데이트를 운영합니다. 변화하는 AI 환경에 맞춰 콘텐츠 구조와 최적화 기준을 지속적으로 개선합니다."],
["경쟁사가 AI에서 더 많이 노출될 때 대응 전략이 있나요?","특정 경쟁사를 직접 추적하는 방식은 아니며, 동종 업종 전체의 AI 유입 집계 데이터와 자사 데이터를 비교 제공합니다. 업종 평균 대비 자사 노출 수준을 파악해 포지션 확인 및 개선 방향 설정에 활용할 수 있습니다."],
["GEO 최적화가 기존 SEO에도 영향을 미치나요?","GEO는 SEO를 기반으로 발전한 기술입니다. GEO 최적화 시 콘텐츠 구조·메타데이터·페이지 품질이 함께 개선되어, 기존 포털 검색 자연유입 상승에도 긍정적인 영향을 줍니다. 하나의 도입으로 AI 검색과 기존 검색을 동시에 최적화하는 효과를 기대할 수 있습니다."],
]},

};

const POPULAR = ["원태그 설치","기존 광고 태그 처리","GEO 점수","비쇼핑 가이드","AI 유입 트래킹"];
const ORDER = NAV.flatMap(s=>s.ids).filter(id=>!A[id].soon);

/* ============== RENDER ============== */
const $=s=>document.querySelector(s);
const homeView=$("#homeView"), searchView=$("#searchView"), docView=$("#docView");

function show(view){
  [homeView,searchView,docView].forEach(v=>v.classList.add("hide"));
  view.classList.remove("hide");
  $("#menuBtn").style.visibility = (view===docView)?"visible":"hidden";
  closeSidebar();
}

function buildHome(){
  $("#heroChips").innerHTML = POPULAR.map(p=>`<span class="chip" onclick="quickSearch('${p}')">${p}</span>`).join("");
  $("#homeCats").innerHTML = NAV.map(sec=>`
    <section class="cat-block">
      <div class="cat-head">
        <div class="cat-ic">${sec.em}</div>
        <div><h2>${sec.cat}</h2><p>${sec.desc}</p></div>
      </div>
      <div class="card-grid">
        ${sec.ids.map(id=> A[id].soon
          ? `<div class="gcard soon">
            <h3>${A[id].title}<span class="badge-soon">준비중</span></h3>
            <span>${A[id].lead}</span>
          </div>`
          : `<div class="gcard" onclick="openArticle('${id}')">
            <h3>${A[id].title}</h3>
            <span>${A[id].lead}</span>
          </div>`).join("")}
      </div>
    </section>`).join("");
}

function buildSidebar(activeId){
  $("#sidebar").innerHTML = NAV.map(sec=>`
    <div class="side-sec">
      <div class="side-sec-title"><span class="em">${sec.em}</span>${sec.cat}</div>
      ${sec.ids.map(id=> A[id].soon
        ? `<span class="side-link soon">${A[id].title} (준비중)</span>`
        : `<a class="side-link ${id===activeId?'active':''}" onclick="openArticle('${id}')">${A[id].title}</a>`).join("")}
    </div>`).join("");
}

function articleBody(id){
  const a=A[id];
  if(a.faq){
    return `<div class="faq">${a.faq.map(([q,ans])=>`
      <div class="faq-item">
        <div class="faq-q" onclick="this.parentElement.classList.toggle('open')">
          <span class="b">Q</span><span class="qt">${q}</span><span class="tog">+</span>
        </div>
        <div class="faq-a">${ans}</div>
      </div>`).join("")}</div>`;
  }
  return a.body;
}

function openArticle(id){
  const a=A[id]; if(!a || a.soon) return;
  buildSidebar(id);
  const idx=ORDER.indexOf(id);
  const prev=idx>0?ORDER[idx-1]:null, next=idx<ORDER.length-1?ORDER[idx+1]:null;
  $("#article").innerHTML=`
    <div class="crumb"><a onclick="goHome()">홈</a><span class="sep">›</span><a onclick="goHome()">${a.cat}</a><span class="sep">›</span><span>${a.title}</span></div>
    <h1>${a.title}</h1>
    <p class="lead">${a.lead}</p>
    <div class="meta">i-GEO 헬프센터 · ${a.cat}</div>
    ${articleBody(id)}
    <div class="helpful">
      <span>이 문서가 도움이 되었나요?</span>
      <div class="btns"><button onclick="thx(this)">👍 도움돼요</button><button onclick="thx(this)">🙏 아쉬워요</button></div>
    </div>
    <div class="pager">
      ${prev?`<a onclick="openArticle('${prev}')"><div class="lbl">← 이전</div><div class="ttl">${A[prev].title}</div></a>`:`<a style="visibility:hidden"></a>`}
      ${next?`<a class="next" onclick="openArticle('${next}')"><div class="lbl">다음 →</div><div class="ttl">${A[next].title}</div></a>`:`<a style="visibility:hidden"></a>`}
    </div>`;
  history.replaceState(null,"",`#a/${id}`);
  show(docView);
  window.scrollTo({top:0,behavior:"instant"in document.documentElement.style?"instant":"auto"});
  $("#article").scrollTop=0;
}

function thx(btn){btn.textContent="감사합니다!";btn.style.color="var(--accent)";btn.style.borderColor="var(--accent)";}

function plain(html){return html.replace(/<[^>]+>/g," ").replace(/\s+/g," ");}
function runSearch(){
  const q=$("#heroSearch").value.trim();
  if(!q){return;}
  doSearch(q);
}
function quickSearch(q){$("#heroSearch").value=q;doSearch(q);}
function doSearch(q){
  const terms=q.toLowerCase().split(/\s+/).filter(Boolean);
  const results=Object.keys(A).filter(id=>!A[id].soon).map(id=>{
    const a=A[id];
    const hay=(a.title+" "+a.lead+" "+a.cat+" "+(a.faq?a.faq.map(f=>f[0]+" "+f[1]).join(" "):plain(a.body||""))).toLowerCase();
    let score=0;
    terms.forEach(t=>{ if(a.title.toLowerCase().includes(t))score+=5; if(hay.includes(t))score+=1; });
    return {id,score};
  }).filter(r=>r.score>0).sort((x,y)=>y.score-x.score);

  const hl=s=>{let o=s;terms.forEach(t=>{o=o.replace(new RegExp("("+t.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+")","ig"),"<mark>$1</mark>")});return o;};
  $("#srWrap").innerHTML=`
    <h1>'${q}' 검색 결과</h1>
    <div class="cnt">${results.length}개의 문서를 찾았습니다.</div>
    ${results.length? results.map(r=>{const a=A[r.id];return `
      <a class="sr" onclick="openArticle('${r.id}')">
        <div class="c">${a.cat}</div>
        <h3>${hl(a.title)}</h3>
        <p>${hl(a.lead)}</p>
      </a>`}).join("")
      : `<div class="empty">검색 결과가 없습니다. 다른 키워드로 검색해 보세요.<br>또는 모비온 사업부(enp_mobon@enliple.com)로 문의해 주세요.</div>`}`;
  history.replaceState(null,"",`#search/${encodeURIComponent(q)}`);
  show(searchView);
  window.scrollTo(0,0);
}

function goHome(){history.replaceState(null,"","#");show(homeView);window.scrollTo(0,0);}
function focusHeroSearch(){goHome();setTimeout(()=>$("#heroSearch").focus(),60);}

/* sidebar mobile */
function toggleSidebar(){$("#sidebar").classList.toggle("show");$("#scrim").classList.toggle("show");}
function closeSidebar(){$("#sidebar").classList.remove("show");$("#scrim").classList.remove("show");}

/* routing */
function route(){
  const h=location.hash;
  if(h.startsWith("#a/")){const id=h.slice(3);if(A[id]&&!A[id].soon){openArticle(id);return;}}
  if(h.startsWith("#search/")){const q=decodeURIComponent(h.slice(8));$("#heroSearch").value=q;doSearch(q);return;}
  show(homeView);
}

$("#heroSearch").addEventListener("keydown",e=>{if(e.key==="Enter")runSearch();});
buildHome();
route();
window.addEventListener("hashchange",route);
</script>
</body>
</html>
